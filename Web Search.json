      "id": "0e2d4519-d200-4c6e-8408-f4400477b973",
      "name": "Web Search Results",
      "notesInFlow": false,
      "alwaysOutputData": true,
      "notes": "This Node formats external web search results for display only"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ \n  {\n    answer: $json.choices[0].message.content,\n    sources: $items(\"Web Search Results\")[0].json.Results.map(r => ({\n      title: r.title || \"\",\n      url: r.url || \"\",\n      domain: (r.url && r.url.includes(\"://\")) ? r.url.split(\"/\")[2] : \"\"\n    }))\n  } \n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        496,
        32
      ],
      "id": "67588b92-5226-4a3f-ae7f-9b31043a6dcd",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.OPENROUTER_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{\nJSON.stringify({\n  model: \"openrouter/free\",\n  messages: [\n    {\n      role: \"system\",\n      content:\n        \"You summarize web search results into one clear answer. \" +\n        \"You MUST answer in the same language as this text: \\\"\" +\n        $json.original_question +\n        \"\\\". Never switch to another language. \" +\n        \"Write a medium-length explanation (not too short and not too long): usually 1–3 well-structured paragraphs that cover the key ideas clearly, with brief examples only when truly helpful. \" +\n        \"Do NOT start with headings or labels like \\\"Answer:\\\", \\\"Final Answer:\\\", or \\\"Summary:\\\". \" +\n        \"Your answer must be written consistently in a single language. \" +\n        \"If the web results contain words or symbols from other languages or scripts (for example Chinese or Japanese characters like 森林 or 竹), either translate them into the answer language or omit them; do NOT copy such foreign-script tokens into the final answer. \" +\n        \"Do NOT include a Sources/References section or any URLs in the answer text.\"\n    },\n    {\n      role: \"user\",\n      content:\n        \"User question:\\n\" +\n        $json.original_question + \"\\n\\n\" +\n        \"Summarize these web results and give one clear final answer.\\n\\n\" +\n        $json.Results\n          .map(r =>\n            \"Title: \" + r.title + \"\\n\" +\n            \"Content: \" + r.content + \"\\n\" +\n            \"URL: \" + r.url\n          )\n          .join(\"\\n\\n\")\n    }\n  ]\n})\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        288,
        -96
      ],
      "id": "b87ec82f-d282-4fed-9e1c-6cf4f6bbfd91",
      "name": "Summarize Results"
    }
